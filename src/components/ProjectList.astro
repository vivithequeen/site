---
interface Props {
    rows?: number;
    label?: string;
}

const { rows = 16, label = "projects" } = Astro.props;
---

<section
    class="project-list"
    style={`height: ${rows}lh`}
    tabindex="0"
    aria-label={label}
>
    <slot />
</section>

<script>
    // jump a whole row at a time with no smooth gliding, like a terminal
    for (const list of document.querySelectorAll<HTMLElement>(
        ".project-list",
    )) {
        const row = () => parseFloat(getComputedStyle(list).lineHeight);
        let leftover = 0;

        const moveRows = (rows: number) => {
            const current = Math.round(list.scrollTop / row());
            list.scrollTo({
                top: (current + rows) * row(),
                behavior: "instant",
            });
        };

        list.addEventListener(
            "wheel",
            (e) => {
                const atTop = list.scrollTop <= 0;
                const atBottom =
                    list.scrollTop + list.clientHeight >= list.scrollHeight - 1;
                // at either end, let the page scroll instead
                if ((e.deltaY < 0 && atTop) || (e.deltaY > 0 && atBottom))
                    return;
                e.preventDefault();

                const scale = [1, row(), list.clientHeight][e.deltaMode];
                leftover += e.deltaY * scale;
                // trackpads send lots of tiny deltas; save them up until they add up to a row
                const rows = Math.trunc(leftover / row());
                if (rows === 0) return;
                leftover -= rows * row();
                moveRows(rows);
            },
            { passive: false },
        );

        list.addEventListener("keydown", (e) => {
            const page = Math.max(1, Math.floor(list.clientHeight / row()) - 1);
            const keys: Record<string, number> = {
                ArrowDown: 1,
                ArrowUp: -1,
                PageDown: page,
                PageUp: -page,
                " ": e.shiftKey ? -page : page,
                End: Infinity,
                Home: -Infinity,
            };
            const rows = keys[e.key];
            if (rows === undefined) return;
            e.preventDefault();
            if (Number.isFinite(rows)) moveRows(rows);
            else
                list.scrollTo({
                    top: rows > 0 ? list.scrollHeight : 0,
                    behavior: "instant",
                });
        });

        // dragging the scrollbar or swiping can stop anywhere, so round to the nearest row
        list.addEventListener("scrollend", () => {
            const off = list.scrollTop % row();
            const atBottom =
                list.scrollTop + list.clientHeight >= list.scrollHeight - 1;
            if (off !== 0 && !atBottom) moveRows(0);
        });
    }
</script>

<style>
    .project-list {
        /* AI CODE */
        overflow-y: auto; /* AI CODE */
        padding-right: 1ch; /* AI CODE */
    } /* AI CODE */

    /* section headings inside the list get three blank rows above */
    /* to split the sections apart                                 */
    .project-list :global(h2) {
        /* AI CODE */
        font-size: 1em; /* AI CODE */
        margin: 3lh 0 1lh; /* AI CODE */
    } /* AI CODE */

    /* browser default margins would knock the text off the rows of #s */
    .project-list :global(:is(ul, ol, p)) {
        /* AI CODE */
        margin: 0; /* AI CODE */
    } /* AI CODE */

    .project-list :global(h2:first-child) {
        /* AI CODE */
        margin-top: 0; /* AI CODE */
    } /* AI CODE */
</style>
