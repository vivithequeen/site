---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    name: string;
    href?: string;
    year?: string | number;
    tech?: string;
    // a file imported from src/assets, or a web address / path in public/ as a string
    image?: ImageMetadata | string;
    imageAlt?: string;
}

const { name, href, year, tech, image, imageAlt = "" } = Astro.props;
// the frame is about 860px wide; twice that stays sharp on high-res screens
const MAX_WIDTH = 1720;
---

<article class="project">
    <div class="text">
        <p>
            <strong>{href ? <a href={href}>{name}</a> : name}</strong>
            {year && <span> ({year})</span>}
            {tech && <span> | {tech}</span>}
        </p>
        <div class="description">
            <slot />
        </div>
    </div>
    {image && (
        <div class="picture" data-rows>
            {typeof image === "string" ? (
                <img src={image} alt={imageAlt} />
            ) : (
                <Image
                    src={image}
                    alt={imageAlt}
                    width={Math.min(image.width, MAX_WIDTH)}
                />
            )}
        </div>
    )}
</article>

<style>
    .project > * {
        margin: 0;
    }

    .text > * {
        margin: 0;
    }

    .description :global(p) {
        margin: 0;
    }

    .picture :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
    }

    /* a row of dashes between projects, short enough to fit beside the scrollbar */
    .project + .project::before {
        content: "--------------------------------------------------------------------------------";
        display: block;
        /* on narrow screens the dashes are cut off at the edge instead of spilling out */
        overflow: hidden;
        white-space: nowrap;
    }
</style>
