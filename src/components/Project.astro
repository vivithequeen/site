---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    name: string;
    href?: string;
    year?: string | number;
    tech?: string;
    // a file imported from src/assets, or a web address / path in public/ as a string
    image?: ImageMetadata | string;
    imageAlt?: string;
}

const { name, href, year, tech, image, imageAlt = "" } = Astro.props;
// the frame is about 860px wide; twice that stays sharp on high-res screens
const MAX_WIDTH = 1720;
---

<article class="project">
    <p>
        <strong>{href ? <a href={href}>{name}</a> : name}</strong>
        {year && <span> ({year})</span>}
        {tech && <span> | {tech}</span>}
    </p>
    <div class="description">
        <slot />
    </div>
    {image && (
        <div class="picture" data-rows>
            {typeof image === "string" ? (
                <img src={image} alt={imageAlt} />
            ) : (
                <Image
                    src={image}
                    alt={imageAlt}
                    width={Math.min(image.width, MAX_WIDTH)}
                />
            )}{" "}
            {/* AI CODE */}
        </div>
    )}{" "}
    {/* AI CODE */}
</article>

<style>
    .project > * {
        /* AI CODE */
        margin: 0; /* AI CODE */
    } /* AI CODE */

    .description :global(p) {
        /* AI CODE */
        margin: 0; /* AI CODE */
    } /* AI CODE */

    .picture :global(img) {
        /* AI CODE */
        display: block; /* AI CODE */
        max-width: 100%; /* AI CODE */
        height: auto; /* AI CODE */
    } /* AI CODE */

    /* a row of dashes between projects, short enough to fit beside the scrollbar */
    .project + .project::before {
        /* AI CODE */
        content: "--------------------------------------------------------------------------------"; /* AI CODE */
        display: block; /* AI CODE */
    } /* AI CODE */
</style>
