---
import Frame from "../layouts/Frame.astro";
import Project from "../components/Project.astro";
import ScrollBox from "../components/ScrollBox.astro"; // AI CODE
import { getCollection, render } from "astro:content"; // AI CODE

// load a tab in the order it is written, with each description rendered from markdown // AI CODE
const load = async (name: "projects" | "events") => { // AI CODE
    const entries = await getCollection(name); // AI CODE
    entries.sort((a, b) => a.data.order - b.data.order); // AI CODE
    return Promise.all(entries.map(async (e) => ({ ...e.data, Content: (await render(e)).Content }))); // AI CODE
}; // AI CODE
const projects = await load("projects"); // AI CODE
const events = await load("events"); // AI CODE
---

<Frame title="projects">
    <div class="tabs" role="tablist" aria-label="projects or events">
        <button
            type="button"
            role="tab"
            id="tab-projects"
            aria-controls="panel-projects"
            aria-selected="true"
        >
            [ projects ]
        </button>
        <button
            type="button"
            role="tab"
            id="tab-events"
            aria-controls="panel-events"
            aria-selected="false"
        >
            [ events ]
        </button>
    </div>
    <div
        class="split"
        role="tabpanel"
        id="panel-projects"
        aria-labelledby="tab-projects"
    >
        <ScrollBox label="projects"> {/* AI CODE */}
            {projects.map(({ Content, order, ...p }) => <Project {...p}><Content /></Project>)} {/* AI CODE */}
        </ScrollBox> {/* AI CODE */}
    </div>
    <div role="tabpanel" id="panel-events" aria-labelledby="tab-events" hidden>
        <ScrollBox label="events"> {/* AI CODE */}
            {events.map(({ Content, order, ...e }) => <Project {...e}><Content /></Project>)} {/* AI CODE */}
        </ScrollBox> {/* AI CODE */}
    </div>
</Frame>
<script>
    // switch between the projects and events lists. the tab is kept in the url // AI CODE
    // hash so /projects#events links straight to the events tab // AI CODE
    const tabs = [
        ...document.querySelectorAll<HTMLButtonElement>(".tabs [role=tab]"),
    ]; // AI CODE

    const show = (tab: HTMLButtonElement) => {
        // AI CODE
        for (const t of tabs) {
            // AI CODE
            const on = t === tab; // AI CODE
            t.setAttribute("aria-selected", String(on)); // AI CODE
            document.getElementById(t.getAttribute("aria-controls")!)!.hidden =
                !on; // AI CODE
        } // AI CODE
    }; // AI CODE

    for (const tab of tabs) {
        // AI CODE
        tab.addEventListener("click", () => {
            // AI CODE
            show(tab); // AI CODE
            history.replaceState(null, "", `#${tab.id.replace("tab-", "")}`); // AI CODE
        }); // AI CODE
    } // AI CODE

    const fromHash = tabs.find((t) => t.id === `tab-${location.hash.slice(1)}`); // AI CODE
    if (fromHash) show(fromHash); // AI CODE
</script>
<style>
    /* the tabs look like the nav links: plain bracketed text */
    .tabs {
        display: flex;
        gap: 2ch;
    }

    .tabs button {
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font: inherit;
        cursor: pointer;
    }

    .tabs [aria-selected="true"] {
        font-weight: bold;
    }

    /* projects with a picture are split in two, and the picture swaps sides */
    /* every other project:  image | text,  then  text | image               */
    .split :global(.project:has(.picture)) {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 2ch;
        align-items: start;
    }

    .split :global(.project:has(.picture):nth-of-type(odd) .picture) {
        order: -1;
    }

    /* the row of dashes between projects stays above both halves */
    .split :global(.project:has(.picture)::before) {
        grid-column: 1 / -1;
        order: -2;
    }

    /* phones are too narrow for two halves: the picture goes on top, then the text */
    @media (max-width: 640px) {
        .split :global(.project:has(.picture)) {
            grid-template-columns: 1fr;
        }

        .split :global(.project:has(.picture) .picture) {
            order: -1;
        }
    }
</style>
