---
import { Image } from "astro:assets"; //AI CODE
import type { ImageMetadata } from "astro"; //AI CODE

interface Props { //AI CODE
    name: string; //AI CODE
    href?: string; //AI CODE
    year?: string | number; //AI CODE
    tech?: string; //AI CODE
    // a file imported from src/assets, or a web address / path in public/ as a string //AI CODE
    image?: ImageMetadata | string; //AI CODE
    imageAlt?: string; //AI CODE
} //AI CODE

const { name, href, year, tech, image, imageAlt = "" } = Astro.props; //AI CODE
// the frame is about 860px wide; twice that stays sharp on high-res screens //AI CODE
const MAX_WIDTH = 1720; //AI CODE
---

<article class="project"> <!--AI CODE-->
    <p> <!--AI CODE-->
        <strong>{href ? <a href={href}>{name}</a> : name}</strong>{year && <span> ({year})</span>}{tech && <span> | {tech}</span>} <!--AI CODE-->
    </p> <!--AI CODE-->
    <div class="description"><slot /></div> <!--AI CODE-->
    {image && ( //AI CODE
        <div class="picture" data-rows> <!--AI CODE-->
            {typeof image === "string" ? <img src={image} alt={imageAlt} /> : <Image src={image} alt={imageAlt} width={Math.min(image.width, MAX_WIDTH)} />} {/* AI CODE */}
        </div> //AI CODE
    )} {/* AI CODE */}
</article> <!--AI CODE-->

<style>
    .project > * {
        /* AI CODE */
        margin: 0; /* AI CODE */
    } /* AI CODE */

    .description :global(p) {
        /* AI CODE */
        margin: 0; /* AI CODE */
    } /* AI CODE */

    .picture :global(img) {
        /* AI CODE */
        display: block; /* AI CODE */
        max-width: 100%; /* AI CODE */
        height: auto; /* AI CODE */
    } /* AI CODE */

    /* a row of dashes between projects, short enough to fit beside the scrollbar */
    .project + .project::before {
        /* AI CODE */
        content: "--------------------------------------------------------------------------------"; /* AI CODE */
        display: block; /* AI CODE */
    } /* AI CODE */
</style>
