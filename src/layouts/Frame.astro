---
import { Font } from "astro:assets";

interface Props {
    title?: string;
    frontmatter?: { title?: string };
}

const title = Astro.props.title ?? Astro.props.frontmatter?.title ?? "";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const docTitle =
    path === "/" ? "violetquinn.dev" : `${title} | violetquinn.dev`;

const pages = [
    { href: "/", label: "home" },
    { href: "/about", label: "about" },
    { href: "/projects", label: "projects" },
    { href: "/contact", label: "contact and friends" },
];

const edge = ("#".repeat(100) + "\n").repeat(2).trimEnd();
// taller than any page will be; the wall is clipped to the content's height
const wall = "#####\n".repeat(500);
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <Font cssVariable="--font-noto-sans-mono" preload />
        <title>{docTitle}</title>
        <script is:inline>
            // set before first paint so dark mode doesn't flash white on load
            try {
                if (localStorage.getItem("theme") === "dark")
                    document.documentElement.classList.add("dark");
            } catch {}
        </script>
    </head>
    <body>
        <div class="frame">
            <div class="edge">{edge}</div>
            <div class="middle">
                <div class="wall" aria-hidden="true">
                    <span>{wall}</span>
                </div>
                <div class="inner">
                    <main>
                        <div class="content">
                            <p>&gt;{title}</p>
                            <slot />
                            <p>
                                &gt;<span class="cursor"></span>
                            </p>
                        </div>
                        <div class="spacer"></div>
                    </main>
                    <nav>
                        {pages.map((p) => (
                            <a
                                href={p.href}
                                aria-current={
                                    p.href === path ? "page" : undefined
                                }
                            >
                                [ {p.label} ]
                            </a>
                        ))}{" "}
                        {/* AI CODE */}
                        <button class="theme" type="button">
                            [ dark ]
                        </button>
                    </nav>
                </div>
                <div class="wall" aria-hidden="true">
                    <span>{wall}</span>
                </div>
            </div>
            <div class="edge">{edge}</div>
        </div>

        <script>
            // images can be any height, which would knock the text below them off
            // the rows of #s. pad them (and the whole page) to a whole number of rows.
            const content = document.querySelector<HTMLElement>(".content")!;
            const spacer = document.querySelector<HTMLElement>(".spacer")!;
            const row = () => parseFloat(getComputedStyle(content).lineHeight);
            const extra = (height: number) =>
                Math.ceil(height / row() - 0.01) * row() - height;

            // [data-rows] wraps one element, like an image
            const boxes = new ResizeObserver((entries) => {
                for (const { target } of entries) {
                    const box = target.parentElement!;
                    box.style.paddingBottom = `${extra(target.getBoundingClientRect().height)}px`;
                }
            });
            document
                .querySelectorAll("[data-rows] > *")
                .forEach((el) => boxes.observe(el));

            const theme = document.querySelector<HTMLButtonElement>(".theme")!;
            const label = () => {
                theme.textContent = document.documentElement.classList.contains(
                    "dark",
                )
                    ? "[ light ]"
                    : "[ dark ]";
            };
            label();
            theme.addEventListener("click", () => {
                const dark = document.documentElement.classList.toggle("dark");
                try {
                    localStorage.setItem("theme", dark ? "dark" : "light");
                } catch {}
                label();
            });

            // emails are stored base64 encoded in data-email so scrapers reading the
            // html don't see an address. decode them into real links once js runs
            document
                .querySelectorAll<HTMLAnchorElement>("a[data-email]")
                .forEach((a) => {
                    const email = atob(a.dataset.email!);
                    a.href = `mailto:${email}`;
                    a.textContent = email;
                });

            new ResizeObserver(() => {
                spacer.style.height = `${extra(content.getBoundingClientRect().height)}px`;
            }).observe(content);
        </script>
    </body>
</html>

<style is:global>
    /* dark mode just inverts everything. the backgrounds are set explicitly */
    /* so they get inverted too instead of staying the browser's white       */
    html,
    body {
        /* AI CODE */
        background: #fff; /* AI CODE */
    } /* AI CODE */

    html.dark {
        /* AI CODE */
        background: #000; /* AI CODE */
    } /* AI CODE */

    html.dark body {
        /* AI CODE */
        filter: invert(1); /* AI CODE */
    } /* AI CODE */

    /* inverting twice puts images back to their real colors */
    html.dark img {
        /* AI CODE */
        filter: invert(1); /* AI CODE */
    } /* AI CODE */

    body {
        /* AI CODE */
        margin: 0; /* AI CODE */
        min-height: 100vh; /* AI CODE */
        display: grid; /* AI CODE */
        place-items: center; /* AI CODE */
        font-family: var(--font-noto-sans-mono); /* AI CODE */
        line-height: 22px; /* AI CODE */
    } /* AI CODE */

    .frame {
        /* AI CODE */
        max-width: 100%; /* AI CODE */
        overflow-x: auto; /* AI CODE */
        padding: 1lh 0; /* AI CODE */
    } /* AI CODE */

    .edge,
    .wall span {
        /* AI CODE */
        white-space: pre; /* AI CODE */
    } /* AI CODE */

    .middle {
        /* AI CODE */
        display: grid; /* AI CODE */
        grid-template-columns: 5ch 90ch 5ch; /* AI CODE */
    } /* AI CODE */

    .wall {
        /* AI CODE */
        position: relative; /* AI CODE */
        overflow: hidden; /* AI CODE */
    } /* AI CODE */

    .wall span {
        /* AI CODE */
        position: absolute; /* AI CODE */
        inset: 0 auto auto 0; /* AI CODE */
    } /* AI CODE */

    .inner {
        /* AI CODE */
        display: flex; /* AI CODE */
        flex-direction: column; /* AI CODE */
        min-height: 22lh; /* AI CODE */
        padding: 1lh 2ch; /* AI CODE */
    } /* AI CODE */

    main {
        /* AI CODE */
        flex: 1; /* AI CODE */
    } /* AI CODE */

    /* keep everything on the text grid: one blank row between blocks, */
    /* and headings the same size as the text so rows stay even        */
    .content > * {
        /* AI CODE */
        margin: 0 0 1lh; /* AI CODE */
    } /* AI CODE */

    .content > :last-child {
        /* AI CODE */
        margin-bottom: 0; /* AI CODE */
    } /* AI CODE */

    .content :is(h1, h2, h3, h4, h5, h6) {
        /* AI CODE */
        font-size: 1em; /* AI CODE */
    } /* AI CODE */

    /* underline section headings with a row of =, like a plain text file */
    .content h2::after {
        /* AI CODE */
        content: "================================================================================"; /* AI CODE */
        display: block; /* AI CODE */
        font-weight: normal; /* AI CODE */
    } /* AI CODE */

    .content :is(ul, ol) {
        /* AI CODE */
        padding-left: 2ch; /* AI CODE */
    } /* AI CODE */

    .content img {
        /* AI CODE */
        display: block; /* AI CODE */
        max-width: 100%; /* AI CODE */
        height: auto; /* AI CODE */
    } /* AI CODE */

    /* a row of 88x31 buttons. it sits in a [data-rows] box so the rows */
    /* below it stay lined up with the #s however many lines it wraps to */
    .content .buttons {
        /* AI CODE */
        display: flex; /* AI CODE */
        flex-wrap: wrap; /* AI CODE */
        gap: 8px 1ch; /* AI CODE */
    } /* AI CODE */

    .content .buttons img {
        /* AI CODE */
        width: auto; /* AI CODE */
        height: 31px; /* AI CODE */
        /* keep the pixel art crisp instead of blurry */
        image-rendering: pixelated; /* AI CODE */
    } /* AI CODE */

    nav {
        /* AI CODE */
        display: flex; /* AI CODE */
        gap: 2ch; /* AI CODE */
        margin-top: 1lh; /* AI CODE */
    } /* AI CODE */

    /* sits at the far right of the nav row, styled like the links' text */
    .theme {
        /* AI CODE */
        margin-left: auto; /* AI CODE */
        padding: 0; /* AI CODE */
        border: 0; /* AI CODE */
        background: none; /* AI CODE */
        color: inherit; /* AI CODE */
        font: inherit; /* AI CODE */
        cursor: pointer; /* AI CODE */
    } /* AI CODE */

    .cursor {
        /* AI CODE */
        display: inline-block; /* AI CODE */
        width: 1ch; /* AI CODE */
        height: 1.1em; /* AI CODE */
        vertical-align: text-bottom; /* AI CODE */
        background: currentColor; /* AI CODE */
        animation: blink 1s steps(1) infinite; /* AI CODE */
    } /* AI CODE */

    @keyframes blink {
        /* AI CODE */
        50% {
            /* AI CODE */
            opacity: 0; /* AI CODE */
        } /* AI CODE */
    } /* AI CODE */

    @media (prefers-reduced-motion: reduce) {
        /* AI CODE */
        .cursor {
            /* AI CODE */
            animation: none; /* AI CODE */
        } /* AI CODE */
    } /* AI CODE */
</style>
